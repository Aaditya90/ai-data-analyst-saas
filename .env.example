# ==========================================================
# AI Data Analyst SaaS — Environment Configuration
# Copy this file to .env and fill in real values.
# Values marked "(future phase)" are placeholders wired into
# config now so later phases don't require re-plumbing.
# ==========================================================

# --- App ---
ENVIRONMENT=development            # development | staging | production
APP_NAME=ai-data-analyst
API_PORT=8000
WEB_PORT=3000
LOG_LEVEL=info

# --- Database (Postgres) ---
POSTGRES_USER=analyst_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=ai_data_analyst
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://analyst_admin:change_me_locally@localhost:5432/ai_data_analyst

# --- App runtime DB connection (Phase 15) ---
# The API connects with this (falls back to DATABASE_URL above if left
# blank). Point it at the low-privilege `app_runtime` role that migration
# 0010 creates — NOT the admin/owner role above — so Row-Level Security
# is actually enforced instead of bypassed by an owner connection.
# `app_runtime` has no password baked into the migration; after running
# `alembic upgrade head`, set one yourself:
#   ALTER ROLE app_runtime WITH PASSWORD 'something-not-in-git';
# then fill in APP_DB_URL with it. Leaving this blank is fine for local
# dev — the app just runs as the admin role as it always has, with RLS
# policies present but not enforced against that connection.
APP_DB_URL=

# --- Redis (queueing/caching, used from Phase 10+) ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (MinIO locally / S3 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=change_me_locally
S3_BUCKET_NAME=ai-analyst-uploads
S3_REGION=us-east-1

# --- Data Ingestion (Phase 3) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
MAX_UPLOAD_SIZE_MB=200
DATASET_PREVIEW_ROW_LIMIT=50

# --- Auth (Phase 2) ---
AUTH_PROVIDER=clerk                # clerk | auth0
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=                    # Clerk Dashboard -> API Keys -> Advanced -> JWKS URL
CLERK_ISSUER=                      # Your Clerk frontend API URL, e.g. https://xxx.clerk.accounts.dev
JWT_SECRET=change_me_locally

# --- AI Provider (Phase 7) ---
ANTHROPIC_API_KEY=
AI_QUERY_ROW_LIMIT=500
AI_MODEL=claude-sonnet-4-6

# --- Team Collaboration (Phase 12) ---
# SMTP is optional: leave SMTP_HOST empty in dev and invite emails are just
# logged (with the accept link) instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
FRONTEND_BASE_URL=http://localhost:3000

# --- CORS (Phase 15) ---
# Production only — dev always allows http://localhost:3000 automatically.
# Comma-separated, e.g. https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

# --- Billing (Phase 14) ---
# Reading plan/usage/limits never needs these — only checkout, the billing
# portal, and the webhook do. Leave them blank in dev and those specific
# endpoints return 503/501 instead of a fake success.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# --- Observability (Phase 16) ---
# All optional — every one of these degrades gracefully when unset (see
# app/core/error_tracking.py and app/services/ai_client.py).
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

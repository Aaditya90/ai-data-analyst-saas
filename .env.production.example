# Phase 18: production environment for docker-compose.prod.yml.
# Copy to .env.production (git-ignored — never commit real values).
# Use URL-safe passwords for anything embedded in a connection URL:
#   openssl rand -hex 24

# --- Domains (DNS for both must point at this host) ---
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# --- Postgres ---
POSTGRES_USER=analyst_admin
POSTGRES_PASSWORD=
POSTGRES_DB=ai_data_analyst
# Password for the low-privilege app_runtime role the API connects as
# (this is what makes Row-Level Security enforced). Set by the migrate job.
APP_RUNTIME_PASSWORD=

# --- Object storage (bundled MinIO) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=ai-analyst-uploads
S3_REGION=us-east-1

# --- Secrets ---
JWT_SECRET=                # openssl rand -hex 32  (>= 32 chars, enforced at startup)
DATA_ENCRYPTION_KEY=       # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Auth (Clerk) — all required ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=

# --- Optional integrations (each degrades gracefully when blank) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOG_LEVEL=INFO

# --- Image tags (only if pulling prebuilt images from a registry) ---
# API_IMAGE=ghcr.io/your-org/ai-analyst-api
# WEB_IMAGE=ghcr.io/your-org/ai-analyst-web
# IMAGE_TAG=latest
